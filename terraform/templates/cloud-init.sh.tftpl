#!/bin/bash
set -euo pipefail
umask 077
exec > /var/log/defense-lab-bootstrap.log 2>&1
trap 'echo "Bootstrap failed; see /var/log/defense-lab-bootstrap.log"' ERR
export DEBIAN_FRONTEND=noninteractive
apt-get -o DPkg::Lock::Timeout=300 update
apt-get -o DPkg::Lock::Timeout=300 install -y python3-venv python3-pip unzip curl ca-certificates gnupg awscli
install -d -m 0755 /opt/aws-defense-lab
for attempt in $(seq 1 30); do
  if aws s3 cp 's3://${artifact_bucket}/${artifact_key}' /tmp/defense-lab.zip --region '${region}' --only-show-errors; then break; fi
  sleep 10
done
echo '${artifact_sha}  /tmp/defense-lab.zip' | sha256sum -c -
unzip -q /tmp/defense-lab.zip -d /opt/aws-defense-lab
find /opt/aws-defense-lab -type d -exec chmod 0755 {} +
find /opt/aws-defense-lab -type f -exec chmod 0644 {} +
cat > /etc/defense-lab.env <<'LAB_SETTINGS'
${settings}
LAB_SETTINGS
chmod 0600 /etc/defense-lab.env
set -a
source /etc/defense-lab.env
set +a
bash /opt/aws-defense-lab/scripts/provision-${component}.sh
touch /opt/aws-defense-lab/READY
